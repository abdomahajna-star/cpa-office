# URL of your deployed web app
APP_URL=https://cpa-office.vercel.app

# Must match SHIKLOLET_AGENT_SECRET in the web app's .env
AGENT_SECRET=change-this-to-a-long-random-secret

# Full path to the Shiklolet executable on this computer
SHIKLOLET_EXE=C:\Program Files\Shiklolet\Shiklolet.exe

# Folder where Shiklolet exports PDFs (or where the agent saves them)
EXPORT_DIR=C:\Users\YourName\Desktop\ShikloletExports

# How often (in seconds) to check for new tasks
POLL_INTERVAL=30
