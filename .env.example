# ─── Database (Neon PostgreSQL) ────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/cpa_office?sslmode=require"

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string-at-least-64-chars"

# ─── File Storage (Vercel Blob) ─────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ─── Local Shiklolet Agent ──────────────────────────────────────────────────
# A secret key shared between this web app and the Python agent running
# on the office PC. Must be a random string ≥ 32 chars.
SHIKLOLET_AGENT_SECRET="change-this-to-a-long-random-secret"

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
